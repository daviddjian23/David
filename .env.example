# ================================
# Configuration n8n Avatar Video Automation
# ================================

# ================================
# D-ID API (Génération d'avatars)
# ================================
# Obtenir sur : https://www.d-id.com/
DID_API_KEY=your_did_api_key_here
DID_API_URL=https://api.d-id.com

# ================================
# OpenAI API (Génération de scripts)
# ================================
# Obtenir sur : https://platform.openai.com/
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# ================================
# Alternative : Claude API
# ================================
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-opus-20240229

# ================================
# TikTok API
# ================================
# Obtenir sur : https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
TIKTOK_REFRESH_TOKEN=your_tiktok_refresh_token

# ================================
# Instagram Graph API
# ================================
# Obtenir sur : https://developers.facebook.com/
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_USER_ID=your_instagram_user_id

# ================================
# YouTube Data API v3
# ================================
# Obtenir sur : https://console.cloud.google.com/
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_ACCESS_TOKEN=your_youtube_access_token
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token
YOUTUBE_API_KEY=your_youtube_api_key

# ================================
# Configuration Vidéo
# ================================
# Nombre de parties à générer
VIDEO_PARTS_COUNT=8

# Durée de chaque partie (en secondes)
VIDEO_PART_DURATION=8

# Plateforme par défaut (tiktok, instagram, youtube_shorts, youtube)
DEFAULT_PLATFORM=tiktok

# Qualité vidéo (low, medium, high)
VIDEO_QUALITY=high

# Format de sortie (mp4, mov)
OUTPUT_FORMAT=mp4

# ================================
# Configuration Avatar
# ================================
# URL de l'image de base pour l'avatar (optionnel)
AVATAR_SOURCE_URL=https://example.com/avatar.jpg

# Expression de l'avatar (happy, sad, surprised, neutral)
AVATAR_EXPRESSION=happy

# Intensité de l'expression (0.0 - 1.0)
AVATAR_EXPRESSION_INTENSITY=1.0

# ================================
# Configuration FFmpeg
# ================================
# Chemin vers FFmpeg (laisser vide pour utiliser le PATH système)
FFMPEG_PATH=

# Dossier temporaire pour les vidéos
TEMP_VIDEO_DIR=/tmp/n8n-videos

# Activer le GPU pour l'encodage (true/false)
ENABLE_GPU_ENCODING=false

# Codec vidéo (libx264, h264_nvenc pour GPU)
VIDEO_CODEC=libx264

# Preset FFmpeg (ultrafast, superfast, veryfast, faster, fast, medium, slow, slower, veryslow)
FFMPEG_PRESET=medium

# ================================
# Configuration Contenu
# ================================
# Thème par défaut des vidéos
DEFAULT_TOPIC=Motivation quotidienne

# Style de contenu (humoristique, éducatif, motivationnel, informationnel)
CONTENT_STYLE=motivationnel

# Ton (casual, professionnel, énergique)
CONTENT_TONE=énergique

# Public cible (jeunes, adultes, professionnels)
TARGET_AUDIENCE=adultes

# Langue (fr, en, es, de, it)
CONTENT_LANGUAGE=fr

# ================================
# Configuration Publication
# ================================
# Activer la publication automatique (true/false)
AUTO_PUBLISH=true

# Plateformes à publier (tiktok,instagram,youtube)
PUBLISH_PLATFORMS=tiktok,instagram,youtube

# Hashtags par défaut (séparés par des virgules)
DEFAULT_HASHTAGS=#IA,#Avatar,#Automation,#n8n

# Texte du filigrane (laisser vide pour désactiver)
WATERMARK_TEXT=@VotreChannel

# Position du filigrane (top-left, top-right, bottom-left, bottom-right, center)
WATERMARK_POSITION=bottom-right

# ================================
# Configuration n8n
# ================================
# URL de base n8n (si self-hosted)
N8N_BASE_URL=http://localhost:5678

# Webhook URL pour les callbacks
N8N_WEBHOOK_URL=http://localhost:5678/webhook

# Activer les logs détaillés (true/false)
ENABLE_DEBUG_LOGS=false

# ================================
# Configuration Musique de Fond
# ================================
# Activer la musique de fond (true/false)
ENABLE_BACKGROUND_MUSIC=false

# URL ou chemin de la musique de fond
BACKGROUND_MUSIC_URL=

# Volume de la musique (0.0 - 1.0)
BACKGROUND_MUSIC_VOLUME=0.3

# ================================
# Configuration Intro/Outro
# ================================
# Chemin vers la vidéo d'intro (optionnel)
INTRO_VIDEO_PATH=

# Chemin vers la vidéo d'outro (optionnel)
OUTRO_VIDEO_PATH=

# ================================
# Configuration Sous-titres
# ================================
# Activer les sous-titres automatiques (true/false)
ENABLE_SUBTITLES=false

# Service de transcription (whisper, google, aws)
TRANSCRIPTION_SERVICE=whisper

# Clé API Whisper (si utilisé)
WHISPER_API_KEY=

# ================================
# Configuration Webhooks
# ================================
# Webhook Discord pour notifications (optionnel)
DISCORD_WEBHOOK_URL=

# Webhook Slack pour notifications (optionnel)
SLACK_WEBHOOK_URL=

# ================================
# Configuration Stockage
# ================================
# Type de stockage (local, s3, gcs, azure)
STORAGE_TYPE=local

# AWS S3 (si utilisé)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1

# Google Cloud Storage (si utilisé)
GCS_PROJECT_ID=
GCS_BUCKET=
GCS_CREDENTIALS_PATH=

# ================================
# Configuration Planification
# ================================
# Activer l'exécution programmée (true/false)
ENABLE_SCHEDULED_EXECUTION=false

# Cron expression (exemple: "0 9 * * *" pour 9h tous les jours)
SCHEDULE_CRON=0 9 * * *

# Fuseau horaire
TIMEZONE=Europe/Paris

# ================================
# Configuration Analytics
# ================================
# Activer le tracking des performances (true/false)
ENABLE_ANALYTICS=false

# Google Analytics ID (optionnel)
GA_TRACKING_ID=

# ================================
# Limites et Quotas
# ================================
# Nombre maximum de vidéos par jour
MAX_VIDEOS_PER_DAY=10

# Délai minimum entre deux générations (en minutes)
MIN_DELAY_BETWEEN_GENERATIONS=30

# Timeout pour la génération d'une vidéo (en secondes)
VIDEO_GENERATION_TIMEOUT=300

# Nombre de tentatives en cas d'échec
MAX_RETRY_ATTEMPTS=3

# ================================
# Divers
# ================================
# Environnement (development, production)
NODE_ENV=production

# Activer le mode verbeux (true/false)
VERBOSE=false

# Conserver les fichiers temporaires (true/false)
KEEP_TEMP_FILES=false

# Nettoyer automatiquement les fichiers de plus de X jours
AUTO_CLEANUP_DAYS=7
