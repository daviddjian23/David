# ==========================================
# Configuration pour l'automatisation n8n
# Avatar Video Automation - Multi-Platform
# ==========================================

# =============================================================================
# APIs de Génération d'Avatar IA
# =============================================================================

# HeyGen API (Génération d'avatars IA réalistes)
# Obtenez votre clé API sur: https://www.heygen.com/
HEYGEN_API_KEY=your_heygen_api_key_here

# Alternative: Ready Player Me (Avatars 3D personnalisables)
# READYPLAYERME_API_KEY=your_readyplayerme_api_key_here

# =============================================================================
# APIs de Génération de Vidéo IA
# =============================================================================

# D-ID API (Vidéos avec avatars parlants)
# Obtenez votre clé API sur: https://www.d-id.com/
DID_API_KEY=your_did_api_key_here

# Alternative: Synthesia API
# SYNTHESIA_API_KEY=your_synthesia_api_key_here

# Alternative: Runway ML API
# RUNWAY_API_KEY=your_runway_api_key_here

# =============================================================================
# APIs de Génération de Scripts
# =============================================================================

# OpenAI API (GPT-4 pour générer les scripts)
# Obtenez votre clé API sur: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Alternative: Anthropic Claude API
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# Configuration Voix (Text-to-Speech)
# =============================================================================

# Voice ID pour D-ID (Microsoft Azure TTS)
# Voix françaises disponibles:
# - fr-FR-DeniseNeural (femme, standard)
# - fr-FR-HenriNeural (homme, standard)
# - fr-FR-BrigitteNeural (femme, premium)
# - fr-FR-AlainNeural (homme, premium)
VOICE_ID=fr-FR-DeniseNeural

# ElevenLabs API (Voix IA ultra-réalistes) - Optionnel
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_VOICE_ID=your_voice_id_here

# =============================================================================
# Instagram Configuration
# =============================================================================

# Instagram Graph API
# Guide: https://developers.facebook.com/docs/instagram-api
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token

# Instagram App Configuration
INSTAGRAM_APP_ID=your_facebook_app_id
INSTAGRAM_APP_SECRET=your_facebook_app_secret

# =============================================================================
# TikTok Configuration
# =============================================================================

# TikTok for Developers API
# Guide: https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token

# =============================================================================
# YouTube Configuration
# =============================================================================

# YouTube Data API v3
# Guide: https://developers.google.com/youtube/v3
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token

# =============================================================================
# Configuration des Vidéos
# =============================================================================

# Nombre de segments à créer (défaut: 8)
NUM_SEGMENTS=8

# Durée de chaque segment en secondes (défaut: 8)
SEGMENT_DURATION=8

# Ajouter des transitions entre les segments (true/false)
ADD_TRANSITIONS=false

# Format de sortie (mp4, mov, webm)
OUTPUT_FORMAT=mp4

# Qualité vidéo (720p, 1080p, 4k)
VIDEO_QUALITY=1080p

# =============================================================================
# Configuration du Planning
# =============================================================================

# Expression cron pour le planning (défaut: tous les jours à 9h)
# Format: minute heure jour mois jour_semaine
# Exemples:
# - "0 9 * * *" = tous les jours à 9h
# - "0 */6 * * *" = toutes les 6 heures
# - "0 9 * * 1-5" = en semaine à 9h
SCHEDULE_CRON=0 9 * * *

# =============================================================================
# Configuration des Chemins
# =============================================================================

# Répertoire temporaire pour les segments
VIDEO_SEGMENTS_DIR=/tmp/video_segments

# Répertoire de sortie pour les vidéos finales
FINAL_VIDEOS_DIR=/tmp/final_videos

# =============================================================================
# Configuration des Topics de Vidéos
# =============================================================================

# Sujets pour les vidéos (séparés par des virgules)
VIDEO_TOPICS=Conseil du jour,Astuce tech,Motivation,Fun fact,DIY rapide

# Catégorie principale
VIDEO_CATEGORY=Education

# Tags par défaut (séparés par des virgules)
DEFAULT_TAGS=IA,Avatar,TikTok,Shorts,Reels

# =============================================================================
# Configuration du Stockage Cloud (Optionnel)
# =============================================================================

# AWS S3 pour stocker les vidéos
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_S3_BUCKET=your-video-bucket
# AWS_REGION=us-east-1

# =============================================================================
# Configuration des Webhooks (Optionnel)
# =============================================================================

# Webhook pour notifications
# WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# =============================================================================
# Configuration Debug
# =============================================================================

# Mode debug (true/false)
DEBUG_MODE=false

# Garder les segments après compilation (true/false)
KEEP_SEGMENTS=false

# Log level (error, warn, info, debug)
LOG_LEVEL=info
